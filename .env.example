# === Required API Credentials ===
ANTHROPIC_API_KEY=       # Anthropic API key (powers Claude Code CLI)
GITHUB_TOKEN=            # GitHub PAT with repo scope
TELEGRAM_BOT_TOKEN=      # Telegram bot token from BotFather
TELEGRAM_CHAT_ID=        # Telegram chat ID for notifications

# === Tool Authentication (used by Claude Code when executing tasks) ===
VERCEL_TOKEN=            # Vercel token , https://vercel.com/account/tokens
VERCEL_TEAM_ID=          # Vercel team ID (e.g. team_xxx) , used for project creation
SUPABASE_ACCESS_TOKEN=   # Supabase access token , https://supabase.com/dashboard/account/tokens

# === Configuration ===
DEFAULT_GITHUB_ORG=your-github-user  # Default GitHub org for new projects
WORKSPACE_DIR=~/workspace/task-agent-projects  # Local directory for cloned repos
POLL_INTERVAL_MS=30000   # Polling interval in ms (default: 30000)
PROJECTS_FILE=           # Custom path to projects.json (default: ~/.task-agent/projects.json)
DASHBOARD_PORT=3000      # Dashboard HTTP port (default: 3000)
DASHBOARD_HOST=127.0.0.1  # Host shown in Telegram links; does not configure the server bind address
